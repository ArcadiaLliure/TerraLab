 from pathlib import Path
+import subprocess
+import sys
 import threading
 import time
 from types import SimpleNamespace
@@ -204,7 +206,168 @@ def test_terrain_coordinator_shutdown_never_leaves_worker_thread_running():
     coordinator.shutdown()
